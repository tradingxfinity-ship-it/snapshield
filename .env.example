# ─── Stripe (payments backend) ───────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Copy this file to `.env.local` and fill in your keys, then restart `npm run dev`.

# Secret key (server only) — starts with sk_test_ or sk_live_
STRIPE_SECRET_KEY=

# Webhook signing secret — from `stripe listen` (local) or the Dashboard (prod)
STRIPE_WEBHOOK_SECRET=

# Your site's public URL (used for Stripe success/cancel redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Admin dashboard (team login) ────────────────────────────
# See ADMIN_SETUP.md for full setup. The site works without these
# (falls back to the built-in catalogue); set them to enable /admin.

# Shared team password for the /admin login screen
ADMIN_PASSWORD=
# Any long random string — signs the admin session cookie
ADMIN_SESSION_SECRET=

# ─── Supabase (admin database + image storage) ───────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is a SERVER-ONLY secret — never expose publicly
SUPABASE_SERVICE_ROLE_KEY=

# ─── Notes ───────────────────────────────────────────────────
# • With no STRIPE_SECRET_KEY set, checkout runs a safe DEMO (no charge).
# • Card, Apple Pay & Google Pay appear automatically on Stripe Checkout.
# • To add PayPal: Stripe Dashboard → Settings → Payment methods → enable PayPal.
# • Local webhook: stripe listen --forward-to localhost:3000/api/webhook
